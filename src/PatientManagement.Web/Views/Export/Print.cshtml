@using System.Globalization
@model PatientManagement.Business.DTOs.ExportPrintDto
@{
    Layout = "~/Views/Shared/_PrintLayout.cshtml";
    ViewData["Title"] = "Patient visits";
}

<div class="d-print-none mb-3">
    <button type="button" class="btn btn-primary" onclick="window.print()">Print</button>
    <a class="ms-3" asp-controller="Export" asp-action="Patient" asp-route-patientId="@Model.PatientId">Back to export</a>
    <p class="text-muted small mt-2 mb-0">
        Press Print, then choose Save as PDF in the print dialog to make a PDF. Printing does not change the record.
    </p>
    @if (!Model.Clinic.IsComplete)
    {
        <div class="alert alert-warning mt-2 mb-0" role="status">
            Clinic details are incomplete. <a asp-controller="ClinicProfile" asp-action="Edit">Complete the clinic details</a>.
        </div>
    }
</div>

<article class="sheet">
    <header class="d-flex justify-content-between align-items-start">
        <div>
            <p class="clinic-name">@(Model.Clinic.ClinicName ?? "Clinic name not entered")</p>
            @if (!string.IsNullOrWhiteSpace(Model.Clinic.Address))
            {
                <div>@Model.Clinic.Address</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Clinic.Phone))
            {
                <div>Phone: @Model.Clinic.Phone</div>
            }
        </div>
        <img src="~/img/clinic-logo-placeholder.svg" alt="Clinic logo (placeholder)" class="logo" />
    </header>

    <hr />

    <table class="table table-sm table-borderless mb-0">
        <tbody>
            <tr>
                <th scope="row" style="width: 30%;">Patient</th>
                <td>@Model.PatientName</td>
                <th scope="row" style="width: 20%;">Patient code</th>
                <td>@Model.PatientCode</td>
            </tr>
            <tr>
                <th scope="row">Date of birth</th>
                <td>@Model.DateOfBirth.ToString("dd-MMM-yyyy", CultureInfo.InvariantCulture)</td>
                <th scope="row">Gender</th>
                <td>@Model.Gender</td>
            </tr>
            <tr>
                <th scope="row">Phone</th>
                <td>@Model.Phone</td>
                <th scope="row">Email</th>
                <td>@Model.Email</td>
            </tr>
            <tr>
                <th scope="row">Address</th>
                <td colspan="3">@Model.Address</td>
            </tr>
            <tr>
                <th scope="row">Visits shown</th>
                <td colspan="3">
                    @if (Model.From is null)
                    {
                        <span>All visits, newest first</span>
                    }
                    else if (Model.To is null || Model.To == Model.From)
                    {
                        <span>On @Model.From.Value.ToString("dd-MMM-yyyy", CultureInfo.InvariantCulture)</span>
                    }
                    else
                    {
                        <span>From @Model.From.Value.ToString("dd-MMM-yyyy", CultureInfo.InvariantCulture) to @Model.To.Value.ToString("dd-MMM-yyyy", CultureInfo.InvariantCulture)</span>
                    }
                </td>
            </tr>
        </tbody>
    </table>

    @if (Model.Visits.Count == 0)
    {
        <p class="mt-4 mb-0">No visits yet.</p>
    }

    @foreach (var visit in Model.Visits)
    {
        <section class="mt-4" style="break-inside: avoid;">
            <h2 class="section-title">Visit on @visit.VisitDateTime.ToString("dd-MMM-yyyy HH:mm", CultureInfo.InvariantCulture)</h2>

            <p class="mb-1">
                @if (visit.TemperatureC is null && visit.SystolicMmHg is null && visit.DiastolicMmHg is null && visit.PulseBpm is null)
                {
                    <span>Vitals: not recorded.</span>
                }
                else
                {
                    <span>
                        Vitals:
                        Temperature @(visit.TemperatureC?.ToString("0.0", CultureInfo.InvariantCulture) ?? "-") °C ·
                        Blood pressure @(visit.SystolicMmHg?.ToString(CultureInfo.InvariantCulture) ?? "-")/@(visit.DiastolicMmHg?.ToString(CultureInfo.InvariantCulture) ?? "-") mmHg ·
                        Pulse @(visit.PulseBpm?.ToString(CultureInfo.InvariantCulture) ?? "-") bpm
                    </span>
                }
            </p>

            <p class="mb-1"><strong>Complaints:</strong> <span style="white-space: pre-line">@(string.IsNullOrWhiteSpace(visit.Complaints) ? "Not recorded." : visit.Complaints)</span></p>
            <p class="mb-2"><strong>Diagnosis:</strong> <span style="white-space: pre-line">@(string.IsNullOrWhiteSpace(visit.Diagnosis) ? "Not recorded." : visit.Diagnosis)</span></p>

            @if (visit.Medicines.Count > 0)
            {
                <table class="prescription-table">
                    <thead>
                        <tr>
                            <th scope="col" style="width: 5%;">No.</th>
                            <th scope="col" style="width: 25%;">Medicine</th>
                            <th scope="col" style="width: 15%;">Dosage</th>
                            <th scope="col" style="width: 15%;">Frequency</th>
                            <th scope="col" style="width: 12%;">Duration</th>
                            <th scope="col">Instructions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var index = 0; index < visit.Medicines.Count; index++)
                        {
                            var line = visit.Medicines[index];
                            <tr>
                                <td>@(index + 1)</td>
                                <td>@line.Name</td>
                                <td>@line.Dosage</td>
                                <td>@line.Frequency</td>
                                <td>@line.Duration</td>
                                <td>@line.Instructions</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="mb-0">Medicines: none recorded.</p>
            }
        </section>
    }

    <footer class="mt-5">
        <div>@Model.Clinic.DoctorName</div>
        <div>Registration number: @Model.Clinic.RegistrationNumber</div>
        <div class="signature-line">Doctor's signature</div>
    </footer>
</article>
