@using System.Globalization
@model PatientManagement.Web.ViewModels.Appointments.AppointmentFormViewModel
@{
    ViewData["Title"] = "Schedule appointment";
    ViewData["Breadcrumbs"] = new List<(string Text, string? Url)>
    {
        ("Patient search", Url.Action("Search", "Patients")),
        (Model.PatientName ?? "Patient", Url.Action("Details", "Patients", new { id = Model.PatientId })),
        ("Schedule appointment", null)
    };
}

<div class="page-header">
    <div>
        <h1 class="h3 mb-1">Schedule appointment</h1>
        <p class="text-muted mb-0">@Model.PatientName (@Model.PatientCode)</p>
    </div>
</div>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<form method="post" asp-controller="Appointments" asp-action="Create">
    <input type="hidden" name="PatientId" value="@Model.PatientId" />

    <div class="row g-2 align-items-end mb-4">
        <div class="col-auto">
            <label for="day" class="form-label">Day</label> <span class="text-danger" aria-hidden="true">*</span>
            <input id="day" name="Date" type="date" class="form-control" required aria-required="true" value="@Model.Date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
            <span asp-validation-for="Date" class="text-danger d-block"></span>
        </div>
        <div class="col-auto">
            <!-- Reloads the slot list for the day in the box. Nothing is saved. -->
            <button id="show-slots" type="submit" class="btn btn-outline-secondary" formaction="@Url.Action("Create", "Appointments")" formmethod="get">Show slots</button>
        </div>
    </div>

    <fieldset class="mb-3">
        <legend class="form-label fs-6">Time (30 minutes) <span class="text-danger" aria-hidden="true">*</span></legend>
        <div class="row">
            @foreach (var slot in Model.Slots)
            {
                <div class="col-6 col-md-4 col-lg-3 mb-2">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="StartTime"
                               id="slot-@slot.Label.Replace(":", "")"
                               value="@slot.StartTime.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture)"
                               checked="@(!slot.IsTaken && Model.StartTime == slot.StartTime)"
                               disabled="@slot.IsTaken" />
                        <label class="form-check-label" for="slot-@slot.Label.Replace(":", "")">
                            @slot.Label @(slot.IsTaken ? "(booked)" : string.Empty)
                        </label>
                    </div>
                </div>
            }
        </div>
        <span asp-validation-for="StartTime" class="text-danger d-block"></span>
    </fieldset>

    <div class="d-flex gap-3">
        <button type="submit" class="btn btn-primary">Save appointment</button>
        <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        // Changing the day reloads the slot list for that day. Nothing is saved; the chosen slot is cleared.
        // Without script, the Show slots button does the same.
        (function () {
            var day = document.getElementById("day");
            var showSlots = document.getElementById("show-slots");
            if (day && showSlots) {
                day.addEventListener("change", function () {
                    day.form.requestSubmit(showSlots);
                });
            }
        })();
    </script>
}
