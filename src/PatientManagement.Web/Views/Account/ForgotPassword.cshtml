@model PatientManagement.Web.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="page-header">
    <div>
        <h1 class="h3 mb-1">Forgot password</h1>
        <p class="text-muted mb-0">Enter your account email and a new password.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-6 col-lg-4">
        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <p class="form-text mb-3">Fields marked <span class="text-danger">*</span> are required.</p>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span>
                <input asp-for="Email" class="form-control" autocomplete="email" autofocus required aria-required="true" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" required aria-required="true" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required aria-required="true" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Reset password</button>
        </form>

        <p class="mt-3">
            <a asp-controller="Account" asp-action="Login">Back to sign in</a>
        </p>
    </div>
</div>
