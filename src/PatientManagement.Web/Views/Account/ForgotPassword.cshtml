@model PatientManagement.Web.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<h1 class="h3 mb-4">Forgot password</h1>

<div class="row">
    <div class="col-md-6 col-lg-4">
        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" autofocus required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" required />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Reset password</button>
        </form>

        <p class="mt-3">
            <a asp-controller="Account" asp-action="Login">Back to sign in</a>
        </p>
    </div>
</div>
