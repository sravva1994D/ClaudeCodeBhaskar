@using System.Globalization
@model PatientManagement.Web.ViewModels.Consultations.ConsultationFormViewModel
@{
    ViewData["Title"] = "Consultation";
}

<h1 class="h3 mb-1">Consultation</h1>
<p class="text-muted mb-4">
    @Model.PatientName (@Model.PatientCode) ·
    Visit @(Model.VisitDateTime?.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)) ·
    @(Model.IsFinished ? "Finished" : "In progress")
</p>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

@if (Model.Warnings.Count > 0)
{
    <div class="alert alert-warning" role="alert">
        <p class="mb-1">Some vitals are outside the expected range. Check them, then select "Confirm and save" to keep them.</p>
        <ul class="mb-0">
            @foreach (var warning in Model.Warnings)
            {
                <li>@warning</li>
            }
        </ul>
    </div>
}

<form method="post" asp-controller="Consultations" asp-action="Edit" asp-route-id="@Model.Id">
    <fieldset class="mb-4">
        <legend class="form-label fs-6">Vitals (all four, or none)</legend>
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <label asp-for="TemperatureC" class="form-label">Temperature (°C)</label>
                <input asp-for="TemperatureC" type="number" step="0.1" min="0" class="form-control" />
                <span asp-validation-for="TemperatureC" class="text-danger"></span>
            </div>
            <div class="col-6 col-md-3">
                <label asp-for="SystolicMmHg" class="form-label">Systolic (mmHg)</label>
                <input asp-for="SystolicMmHg" type="number" min="0" class="form-control" />
                <span asp-validation-for="SystolicMmHg" class="text-danger"></span>
            </div>
            <div class="col-6 col-md-3">
                <label asp-for="DiastolicMmHg" class="form-label">Diastolic (mmHg)</label>
                <input asp-for="DiastolicMmHg" type="number" min="0" class="form-control" />
                <span asp-validation-for="DiastolicMmHg" class="text-danger"></span>
            </div>
            <div class="col-6 col-md-3">
                <label asp-for="PulseBpm" class="form-label">Pulse (bpm)</label>
                <input asp-for="PulseBpm" type="number" min="0" class="form-control" />
                <span asp-validation-for="PulseBpm" class="text-danger"></span>
            </div>
        </div>
    </fieldset>

    <div class="mb-3">
        <label asp-for="Complaints" class="form-label">Complaints</label>
        <textarea asp-for="Complaints" class="form-control" rows="3"></textarea>
    </div>

    <div class="mb-4">
        <label asp-for="Diagnosis" class="form-label">Diagnosis</label>
        <textarea asp-for="Diagnosis" class="form-control" rows="3"></textarea>
    </div>

    <div class="d-flex flex-wrap gap-3 align-items-center">
        <button type="submit" class="btn btn-primary">Save</button>
        @if (Model.Warnings.Count > 0)
        {
            <button type="submit" name="ConfirmWarnings" value="true" class="btn btn-warning">Confirm and save</button>
        }
        <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId">Back to patient</a>
    </div>
</form>

@if (!Model.IsFinished)
{
    <form method="post" asp-controller="Consultations" asp-action="Finish" asp-route-id="@Model.Id" class="mt-4">
        <button type="submit" class="btn btn-outline-success">Finish visit</button>
    </form>
}
