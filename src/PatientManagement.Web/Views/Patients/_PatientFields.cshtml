@model PatientManagement.Web.ViewModels.Patients.PatientFormViewModel

@if (Model.Warnings.Count > 0)
{
    <div class="alert alert-warning" role="alert">
        <p class="mb-1">This patient may already be registered. Check the details below. Select "Confirm and save" to keep this record anyway.</p>
        <ul class="mb-0">
            @foreach (var warning in Model.Warnings)
            {
                <li>@warning</li>
            }
        </ul>
    </div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <p class="form-text mb-3">Fields marked <span class="text-danger">*</span> are required.</p>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span>
            <input asp-for="FullName" class="form-control" required aria-required="true" autofocus />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DateOfBirth" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span>
            <input asp-for="DateOfBirth" type="date" class="form-control" required aria-required="true" />
            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Gender" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span>
            <select asp-for="Gender" class="form-select" required aria-required="true" asp-items="Model.GenderItems"></select>
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span>
            <input asp-for="Phone" class="form-control" autocomplete="tel" required aria-required="true" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span>
            <input asp-for="Email" class="form-control" autocomplete="email" required aria-required="true" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Address" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span>
            <textarea asp-for="Address" class="form-control" rows="2" required aria-required="true"></textarea>
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
    </div>
</div>
