@model PatientManagement.Web.ViewModels.Patients.PatientFormViewModel
@{
    ViewData["Title"] = "Edit patient";
    ViewData["Breadcrumbs"] = new List<(string Text, string? Url)>
    {
        ("Patient search", Url.Action("Search", "Patients")),
        (Model.FullName ?? "Patient", Url.Action("Details", "Patients", new { id = Model.Id })),
        ("Edit", null)
    };
}

<div class="page-header">
    <div>
        <h1 class="h3 mb-1">Edit patient</h1>
        <p class="text-muted mb-0">@Model.PatientCode</p>
    </div>
</div>

<form asp-controller="Patients" asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <partial name="_PatientFields" model="Model" />

    <div class="d-flex gap-2 align-items-center">
        <button type="submit" class="btn btn-primary">Save</button>
        @if (Model.Warnings.Count > 0)
        {
            <button type="submit" name="ConfirmWarnings" value="true" class="btn btn-warning">Confirm and save</button>
        }
        <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
    </div>
</form>
