@model PatientManagement.Business.DTOs.PatientDto
@{
    ViewData["Title"] = "Patient profile";
    ViewData["Breadcrumbs"] = new List<(string Text, string? Url)>
    {
        ("Patient search", Url.Action("Search", "Patients")),
        (Model.FullName, null)
    };
}

<div class="page-header">
    <div>
        <h1 class="h3 mb-1">@Model.FullName</h1>
        <p class="text-muted mb-0">@Model.PatientCode</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary" asp-controller="Patients" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-primary" asp-controller="Appointments" asp-action="Create" asp-route-patientId="@Model.Id">Schedule appointment</a>
        <a class="btn btn-outline-primary" asp-controller="Visits" asp-action="Index" asp-route-patientId="@Model.Id">Visit history</a>
        <a class="btn btn-outline-primary" asp-controller="Export" asp-action="Patient" asp-route-patientId="@Model.Id">Export</a>
        <form method="post" asp-controller="Consultations" asp-action="Start" class="d-inline">
            <input type="hidden" name="patientId" value="@Model.Id" />
            <button type="submit" class="btn btn-primary">Start consultation</button>
        </form>
    </div>
</div>

<dl class="row mb-4">
    <dt class="col-sm-3">Date of birth</dt>
    <dd class="col-sm-9">@Model.DateOfBirth.ToString("dd-MMM-yyyy")</dd>

    <dt class="col-sm-3">Age</dt>
    <dd class="col-sm-9">@Model.Age</dd>

    <dt class="col-sm-3">Gender</dt>
    <dd class="col-sm-9">@Model.Gender</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@Model.Phone</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Address</dt>
    <dd class="col-sm-9">@Model.Address</dd>

    <dt class="col-sm-3">Last visit</dt>
    <dd class="col-sm-9">@(Model.LastVisit is null ? "No visits yet" : Model.LastVisit.Value.ToString("dd-MMM-yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture))</dd>
</dl>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<p><a asp-controller="Patients" asp-action="Search">Back to search</a></p>
