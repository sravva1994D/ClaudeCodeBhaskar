@model PatientManagement.Web.ViewModels.Patients.PatientSearchViewModel
@{
    ViewData["Title"] = "Patient search";
    ViewData["Breadcrumbs"] = new List<(string Text, string? Url)> { ("Patient search", null) };
}

<div class="page-header">
    <div>
        <h1 class="h3 mb-1">Patient search</h1>
        <p class="text-muted mb-0">Find a patient by name or phone number.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" asp-controller="Patients" asp-action="Create">New patient</a>
    </div>
</div>

<form asp-controller="Patients" asp-action="Search" method="get" class="row g-2 mb-4" role="search">
    <div class="col-sm-8 col-md-6">
        <input name="q" value="@Model.Term" class="form-control" placeholder="Name or phone number" aria-label="Search patients" autofocus />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

@if (Model.Searched)
{
    if (Model.Results.Count == 0)
    {
        <p>No patients match your search. <a asp-controller="Patients" asp-action="Create">Register a new patient</a></p>
    }
    else
    {
        <table class="table table-striped w-100 data-table">
            <thead>
                <tr>
                    <th scope="col">Code</th>
                    <th scope="col">Name</th>
                    <th scope="col">Date of birth</th>
                    <th scope="col">Phone</th>
                    <th scope="col" class="no-sort"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Results)
                {
                    <tr>
                        <td>@row.PatientCode</td>
                        <td><a asp-controller="Patients" asp-action="Details" asp-route-id="@row.Id">@row.FullName</a></td>
                        <td data-order="@row.DateOfBirth.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)">@row.DateOfBirth.ToString("dd-MMM-yyyy", System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td>@row.Phone</td>
                        <td><a asp-controller="Appointments" asp-action="Create" asp-route-patientId="@row.Id">Schedule<span class="visually-hidden"> for @row.FullName</span></a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
