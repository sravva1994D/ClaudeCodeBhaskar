<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Patient Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        @@page { size: A4; margin: 15mm; }
        body { color: #000; background: #fff; font-size: 11pt; }
        .sheet { max-width: 180mm; margin: 0 auto; }
        .clinic-name { font-size: 16pt; font-weight: 600; margin: 0 0 2mm 0; }
        .logo { width: 25mm; height: 25mm; }
        .prescription-table { border-collapse: collapse; width: 100%; }
        .prescription-table th,
        .prescription-table td { border: 1px solid #000; padding: 3px 5px; vertical-align: top; }
        .signature-line { margin-top: 18mm; border-top: 1px solid #000; width: 70mm; padding-top: 1mm; }
        .section-title { font-size: 11pt; font-weight: 600; margin: 4mm 0 1mm 0; text-transform: uppercase; }
        @@media print {
            .d-print-none { display: none !important; }
            body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
</head>
<body>
    @RenderBody()
</body>
</html>
