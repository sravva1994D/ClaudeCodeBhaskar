@using System.Globalization
@model PatientManagement.Web.ViewModels.Visits.VisitDetailViewModel
@{
    ViewData["Title"] = "Visit detail";
    var visit = Model.Visit;
    var prescription = Model.Prescription;
    ViewData["Breadcrumbs"] = new List<(string Text, string? Url)>
    {
        ("Patient search", Url.Action("Search", "Patients")),
        (visit.PatientName, Url.Action("Details", "Patients", new { id = visit.PatientId })),
        ("Visit history", Url.Action("Index", "Visits", new { patientId = visit.PatientId })),
        ("Visit", null)
    };
}

<div class="page-header">
    <div>
        <h1 class="h3 mb-1">Visit</h1>
        <p class="text-muted mb-0">
            <a asp-controller="Patients" asp-action="Details" asp-route-id="@visit.PatientId">@visit.PatientName</a> (@visit.PatientCode) ·
            @visit.VisitDateTime.ToString("dd-MMM-yyyy HH:mm", CultureInfo.InvariantCulture) ·
            @(visit.IsFinished ? "Finished" : "In progress") ·
            @(visit.AppointmentId is null ? "Walk-in" : "Appointment")
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary" asp-controller="Consultations" asp-action="Edit" asp-route-id="@visit.Id">Edit visit</a>
    </div>
</div>

<dl class="row mb-4">
    <dt class="col-sm-3">Temperature</dt>
    <dd class="col-sm-9">@(visit.Vitals is null ? "No vitals recorded" : $"{visit.Vitals.TemperatureC.ToString("0.0", CultureInfo.InvariantCulture)} °C")</dd>

    <dt class="col-sm-3">Blood pressure</dt>
    <dd class="col-sm-9">@(visit.Vitals is null ? "No vitals recorded" : $"{visit.Vitals.SystolicMmHg}/{visit.Vitals.DiastolicMmHg} mmHg")</dd>

    <dt class="col-sm-3">Pulse</dt>
    <dd class="col-sm-9">@(visit.Vitals is null ? "No vitals recorded" : $"{visit.Vitals.PulseBpm} bpm")</dd>

    <dt class="col-sm-3">Complaints</dt>
    <dd class="col-sm-9" style="white-space: pre-line">@(string.IsNullOrWhiteSpace(visit.Complaints) ? "None recorded" : visit.Complaints)</dd>

    <dt class="col-sm-3">Diagnosis</dt>
    <dd class="col-sm-9" style="white-space: pre-line">@(string.IsNullOrWhiteSpace(visit.Diagnosis) ? "None recorded" : visit.Diagnosis)</dd>
</dl>

<section class="mb-4" aria-labelledby="visit-medicines">
    <h2 id="visit-medicines" class="h5">Medicines</h2>
    @if (prescription is null || prescription.Lines.Count == 0)
    {
        <p>No medicines recorded.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th scope="col">Medicine</th>
                        <th scope="col">Dosage</th>
                        <th scope="col">Frequency</th>
                        <th scope="col">Duration</th>
                        <th scope="col">Instructions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in prescription.Lines)
                    {
                        <tr>
                            <td>@line.Name</td>
                            <td>@line.Dosage</td>
                            <td>@line.Frequency</td>
                            <td>@line.Duration</td>
                            <td>@line.Instructions</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted small mb-2">
            @(prescription.IsPrinted
                ? $"Printed on {prescription.PrintedAt!.Value.ToString("dd-MMM-yyyy HH:mm", CultureInfo.InvariantCulture)}."
                : "Not printed yet.")
        </p>
        <a class="btn btn-outline-primary" asp-controller="Prescriptions" asp-action="Print" asp-route-consultationId="@visit.Id">Print prescription</a>
    }
</section>

<div class="d-flex flex-wrap gap-3">
    <a asp-controller="Visits" asp-action="Index" asp-route-patientId="@visit.PatientId">Back to visit history</a>
    <a asp-controller="Patients" asp-action="Details" asp-route-id="@visit.PatientId">Back to patient</a>
</div>
