<Project>

  <!--
    Shared settings for every project in PatientManagement.sln.
    Source: CLAUDE.md §8 (nullable reference types enabled).
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Security override. System.Security.Cryptography.Pkcs 9.0.11 (pulled in
    transitively by EF Core tooling) has known advisories
    GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx. Pin the patched 10.0 release
    that matches the .NET 10 runtime. Remove this override when the transitive
    dependency no longer needs it.
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

</Project>
